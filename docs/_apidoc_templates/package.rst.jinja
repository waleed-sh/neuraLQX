{%- macro automodule(name, options) -%}
.. automodule:: {{ name }}
{%- for option in options %}
   :{{ option }}:
{%- endfor %}
{%- endmacro -%}

{%- macro toctree(docnames) -%}
.. toctree::
   :maxdepth: {{ maxdepth }}
{%- for docname in docnames %}
   {{ docname }}
{%- endfor %}
{%- endmacro -%}

{# --- TITLE (removed "package"/"namespace" suffix) --- #}
{{- pkgname | e | heading }}

{%- if modulefirst and not is_namespace %}
{{ automodule(pkgname, automodule_options) }}
{%- endif %}

{%- if subpackages %}
.. rubric:: Subpackages

{{ toctree(subpackages) }}
{%- endif %}

{%- if submodules %}
.. rubric:: Submodules

{%- if separatemodules %}
{{ toctree(submodules) }}
{%- else %}
{%- for submodule in submodules %}
{%- if show_headings %}
{{- submodule | e | heading(2) }}
{%- endif %}
{{ automodule(submodule, automodule_options) }}
{%- endfor %}
{%- endif %}
{%- endif %}

{%- if not modulefirst and not is_namespace %}
.. rubric:: Module contents

{{ automodule(pkgname, automodule_options) }}
{%- endif %}
